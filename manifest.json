{
  "manifest_version": 3,
  "name": "WhatsApp Focus Mode",
  "version": "0.1.0",
  "description": "Abre o WhatsApp Web em modo cego para reduzir distrações e chamarizes.",
  "permissions": ["storage", "clipboardRead", "clipboardWrite", "offscreen"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WhatsApp Focus — informações e atalhos", "default_popup": "export-popup.html" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["awareness.js", "focus-state.js", "focused-recents.js", "fixed-collections.js", "copy-menu.js", "native-surface.js", "surface-expiry.js", "auth-surface.js", "mark-unread.js", "content.js"],
      "css": ["focus.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["archived-unread-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["archived-unread-ui.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["focus.css", "dev-config.json"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "icons": {}
}
